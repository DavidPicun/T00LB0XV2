-- === УНИВЕРСАЛЬНАЯ ЛОГИКА ЗАПРОСА ===
local requestFunc = (syn and syn.request) or (http and http.request) or request or http_request

local function checkKey()
    local nickname = LocalPlayer.Name 
    local key = KeyInput.Text

    if key == "" then
        ErrorLabel.Text = "Key is required"
        return
    end

    ErrorLabel.Text = ""

    if not requestFunc then
        ErrorLabel.Text = "Executor request not supported"
        return
    end

    local success, response = pcall(function()
        return requestFunc({
            Url = SERVER_URL,
            Method = "POST",
            Headers = { 
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Roblox/WinInet"
            },
            Body = HttpService:JSONEncode({ nickname = nickname, key = key })
        })
    end)

    if not success or type(response) ~= "table" then
        warn("Request Failed:", tostring(response))
        ErrorLabel.Text = "Server Offline"
        return
    end

    local statusCode = response.StatusCode or response.status_code or response.Status
    local responseBody = response.Body or response.body

    if not responseBody then
        ErrorLabel.Text = "Server Offline"
        return
    end

    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if statusCode == 200 or (decodeSuccess and data and data.status == "success") then
        ScreenGui:Destroy() 

        local scriptSuccess, scriptError = pcall(function()
            loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
        end)
        
        if not scriptSuccess then 
            warn("Script Load Error: " .. tostring(scriptError)) 
        end
    else
        if decodeSuccess and data and (data.detail or data.message) then
            local serverError = tostring(data.detail or data.message)
            if string.find(serverError, "не подходящий") or string.find(serverError, "неверный") then
                ErrorLabel.Text = "Invalid Key"
            elseif string.find(serverError, "не зарегистрирован") then
                ErrorLabel.Text = "Key not registered to this user"
            else
                ErrorLabel.Text = serverError
            end
        else
            ErrorLabel.Text = "Invalid Key"
        end
    end
end

LoginButton.MouseButton1Click:Connect(checkKey)
